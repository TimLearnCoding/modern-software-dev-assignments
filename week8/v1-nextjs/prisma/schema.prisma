generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model JobBlock {
  id          String   @id @default(uuid())
  title       String
  color       String   @default("#6366f1")
  resumePath  String?
  resumeText  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        JobPost[]
  sources     JobSource[]
}

model JobPost {
  id          String   @id @default(uuid())
  blockId     String
  block       JobBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  title       String
  company     String
  location    String?
  salary      String?
  description String?
  url         String
  source      String   @default("web")
  status      String   @default("to_apply") // to_apply | applied
  appliedAt   DateTime?
  createdAt   DateTime @default(now())
}

model JobSource {
  id          String   @id @default(uuid())
  blockId     String
  block       JobBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  name        String
  url         String?
  type        String   @default("api") // api | custom_url
}
